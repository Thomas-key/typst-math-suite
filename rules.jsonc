{
  // ══════════════════════════════════════════════════════════════
  //  内置规则表。
  //  · 可以直接改这个文件：支持 // 和 /* */ 注释，也允许尾随逗号。
  //  · 也可以在 VS Code 设置里写一个同名的键来覆盖它，
  //    或者写一个新键，那它就是一条新规则。
  //  · 改完这个文件后，需要重新加载窗口才生效。
  // ══════════════════════════════════════════════════════════════

  // ── 数学模式内 · 普通规则（匹配光标所在行的行尾）──
  "inMath": {
      "@a": "alpha",
      "@b": "beta",
      "@g": "gamma",
      "@G": "Gamma",
      "@d": "delta",
      "@D": "Delta",
      "@e": "epsilon.alt",
      ":e": "epsilon",
      "@z": "zeta",
      "@t": "theta",
      "@T": "Theta",
      ":t": "theta.alt",
      "@i": "iota",
      "@k": "kappa",
      "@l": "lambda",
      "@L": "Lambda",
      "@s": "sigma",
      "@S": "Sigma",
      "@u": "upsilon",
      "@U": "Upsilon",
      "@o": "omega",
      "@O": "Omega",
      "@p": "pi",
      "@m": "mu",
      "@f": "phi",
      "@y": "psi",
      "sr": "^2",
      "cb": "^3",
      "rd": "^($1)$0",
      "_": "_($1)$0",
      "sts": "_(\"$0\")",
      "sq": "sqrt($1)$0",
      "//": "frac($1, $2)$0",
      "ee": "e^($1)$0",
      "invs": "^(-1)",
      "conj": "^*",
      "Re": "op(\"Re\")",
      "Im": "op(\"Im\")",
      "bf": "bold($0)",
      "rm": "upright($1)$0",
      "trace": "op(\"Tr\")",
      "+-": "plus.minus",
      "-+": "minus.plus",
      "|...": "dots.v",
      "/...": "dots.down",
      "del": "nabla",
      "xx": "times",
      "**": "dot.op",
      "para": "parallel",
      "simm": "tilde.op",
      "sim=": "tilde.eq",
      "===": "equiv",
      "prop": "prop",
      "!>": "|->",
      "=<": "arrow.l.double.long",
      "and": "inter",
      "orr": "union",
      "inn": "in",
      "notin": "in.not",
      "setm": "without",
      "sub=": "subset.eq",
      "sup=": "supset.eq",
      "eset": "emptyset",
      "set": "{$1}$0",
      "ext": "exists",
      "LL": "cal(L)",
      "HH": "cal(H)",
      "CC": "bb(C)",
      "RR": "bb(R)",
      "ZZ": "bb(Z)",
      "NN": "bb(N)",
      "QQ": "bb(Q)",
      "o+": "⊕",
      "ox": "⊗",
      "ddot": "dot.double($1)$0",
      "cdot": "dot.op",
      "dot": "dot($1)$0",
      "hat": "hat($1)$0",
      "bar": "macron($1)$0",
      "tilde": "tilde($1)$0",
      "und": "#underline[\\$$1\\$]$0",
      "vec": "arrow($1)$0",
      "par": "frac(partial ${1:y}, partial ${2:x}) $0",
      "ddt": "frac(dif, dif t)",
      "iiint": "integral.triple",
      "iint": "integral.double",
      "oint": "integral.cont",
      "oinf": "integral_0^oo $1 dif ${2:x} $0",
      "infi": "integral_(-oo)^oo $1 dif ${2:x} $0",
      "dint": "integral_(${1:0})^(${2:1}) $3 dif ${4:x} $0",
      "int": "integral $1 dif ${2:x} $0",
      "brk": "chevron.l $1 | $2 chevron.r $0",
      "pmat": "mat(delim: \"(\", $0)",
      "bmat": "mat(delim: \"[\", $0)",
      "matrix": "mat($0)",
      "cases": "cases($0)",
      "Norm": "lr(||$1||) $0",
      "norm": "lr(|$1|) $0",
      "ceil": "lr(ceil.l $1 ceil.r) $0",
      "floor": "lr(floor.l $1 floor.r) $0",
      "lra": "lr(chevron.l $1 chevron.r) $0",
      "lr(": "lr(($1)) $0",
      "lr{": "lr({$1}) $0",
      "lr[": "lr([$1]) $0",
      "lr|": "lr(|$1|) $0",
      "tayl": "${1:f}(${2:x} + ${3:h}) = ${1:f}(${2:x}) + ${1:f}'(${2:x})${3:h} + ${1:f}''(${2:x}) frac(${3:h}^2, 2!) + dots $0",
      "lsup": "limsup_(${1:n} -> ${2:oo}) $0",
      "linf": "liminf_(${1:n} -> ${2:oo}) $0",
      "lim": "lim_(${1:n} -> ${2:oo}) $0",
      "sum": "sum_(${1:i}=${2:1})^(${3:N}) $0",
      "prod": "product_(${1:i}=${2:1})^(${3:N}) $0",

      // ── 括号（带停靠点：自己控制光标，不靠编辑器的自动补全）──
      "(": "($1)$0",
      "[": "[$1]$0",

      // ── 组合数 / 排列数 ──
      "Cnn": "C_($1)^($2) $0",
      "Ann": "A_($1)^($2) $0",

      // ── 上下花括号 / 证明符号 / 正文 / n 次根 ──
      "ub": "underbrace($1, $2) $0",
      "ob": "overbrace($1, $2) $0",
      "tf": "therefore",
      "ba": "because",
      "tx": "\"$1\"$0",
      "nsq": "root($1, $2) $0"
  },

  // ── 数学模式外 · 普通规则 ──
  "outMath": {
      "mk": "\\$$1\\$$0",
      "dm": "\\$ $1 \\$$0"
  },

  // ── 数学模式内 · 正则规则（{1}/{2} 是捕获组，$1/$0 是停靠点）──
  "inMathRegex": {
      "([A-Za-z0-9]+)ddot$": "dot.double({1})",
      "([A-Za-z0-9]+)dot$": "dot({1})",
      "([A-Za-z0-9]+)hat$": "hat({1})",
      "([A-Za-z0-9]+)bar$": "macron({1})",
      "([A-Za-z0-9]+)tilde$": "tilde({1})",
      "([A-Za-z0-9]+)und$": "#underline[\\${1}\\$]",
      "([A-Za-z0-9]+)vec$": "arrow({1})",
      "([A-Za-z0-9]+),\\.$": "bold({1})",
      "([A-Za-z0-9]+)\\.,$": "bold({1})",
      "pa([A-Za-z0-9]+)([A-Za-z0-9]+)$": "frac(partial {1}, partial {2})",
      "([A-Za-z0-9]+)/$": "frac({1},$1)$0"
  },

  // ── 数学模式外 · 正则规则 ──
  "outMathRegex": {}
}
